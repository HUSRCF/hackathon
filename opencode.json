{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "autoupdate": false,
  "snapshot": false,
  "subagent_depth": 0,
  "enabled_providers": [
    "hipfire"
  ],
  "provider": {
    "hipfire": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "HipFire local",
      "options": {
        "baseURL": "http://127.0.0.1:11435/v1",
        "timeout": 300000
      },
      "models": {
        "qwen3.5:9b": {
          "name": "Qwen 3.5 9B local",
          "limit": {
            "context": 32768,
            "output": 4096
          }
        }
      }
    }
  },
  "default_agent": "protbind",
  "agent": {
    "protbind": {
      "description": "Operate ProtBind through audited one-stage scientific gates",
      "mode": "primary",
      "temperature": 0.1,
      "prompt": "Load the protbind-research skill before acting and load protbind-library for reusable data operations. Use only the ProtBind MCP tools. Ask before every private document or library data access, treat RAG as retrieval rather than scientific truth, cite document pages or catalog snapshot artifact plus entry ID, recheck the gate before every case mutation, advance exactly one stage per fresh token, and never invent scientific outputs."
    }
  },
  "mcp": {
    "protbind": {
      "type": "local",
      "command": [
        "scripts/aiaa-protbind.sh",
        "-m",
        "protbind_agent",
        "mcp",
        "serve",
        "--workspace",
        "artifacts/protbind",
        "--project-root",
        ".",
        "--library-config",
        ".protbind/library.json",
        "--knowledge-model",
        ".protbind/models/bge-m3"
      ],
      "cwd": ".",
      "enabled": true,
      "timeout": 30000,
      "environment": {
        "HF_HUB_OFFLINE": "1",
        "TRANSFORMERS_OFFLINE": "1"
      }
    }
  },
  "permission": {
    "*": "deny",
    "skill": {
      "*": "deny",
      "protbind-research": "allow",
      "protbind-library": "allow"
    },
    "question": "allow",
    "protbind_doctor": "allow",
    "protbind_case_status": "allow",
    "protbind_case_report": "allow",
    "protbind_case_dossier": "allow",
    "protbind_case_pose_view": "allow",
    "protbind_artifact_metadata": "allow",
    "protbind_control_history": "allow",
    "protbind_knowledge_model_status": "allow",
    "protbind_fetch_public_data": "ask",
    "protbind_case_create": "ask",
    "protbind_case_advance": "ask",
    "protbind_case_attach_support": "ask",
    "protbind_library_status": "ask",
    "protbind_library_list": "ask",
    "protbind_library_show": "ask",
    "protbind_library_plan_import": "ask",
    "protbind_library_apply_import": "ask",
    "protbind_library_verify_uniprot": "ask",
    "protbind_knowledge_document_inspect": "ask",
    "protbind_knowledge_import": "ask",
    "protbind_knowledge_search": "ask",
    "protbind_library_rag_sync": "ask",
    "protbind_library_rag_search": "ask"
  }
}
